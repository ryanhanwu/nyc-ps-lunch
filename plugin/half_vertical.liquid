<div class="layout layout--col gap--space-between lg:gap--large portrait:gap--small">
  <div class="flex flex--col gap--tiny">
    <span class="title title--medium lg:title--xlarge">{{ menu_short | default: "Pre-K – 8" }} Lunch</span>
    <span class="label label--small lg:label--base">NYC Public Schools</span>
  </div>

  <div class="divider"></div>

  {% if current_day %}
  <div class="flex flex--col gap--tiny">
    <span class="label label--underline lg:label--base">{{ current_day.status_label | default: "TODAY" }} • {{ current_day.full_date }}</span>
    {% for item in current_day.items limit: 4 %}
    <span class="value value--small lg:value--large">• {{ item }}</span>
    {% endfor %}
    {% if current_day.salad_bar %}
    <span class="label label--small lg:label--base label--gray">{{ current_day.salad_bar }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  <div class="flex flex--col gap--tiny">
    <span class="label label--underline lg:label--base">UPCOMING</span>
    {% if next_day_1 %}
    <span class="value value--small lg:value--base">
      <strong>{{ next_day_1.day_short }}:</strong> {{ next_day_1.items | first }}{% if next_day_1.items.size > 1 %}, {{ next_day_1.items[1] }}{% endif %}
    </span>
    {% endif %}
    {% if next_day_2 %}
    <span class="value value--small lg:value--base">
      <strong>{{ next_day_2.day_short }}:</strong> {{ next_day_2.items | first }}{% if next_day_2.items.size > 1 %}, {{ next_day_2.items[1] }}{% endif %}
    </span>
    {% endif %}
  </div>
  {% else %}
  <span class="label label--gray lg:label--base">No school lunch menu available.</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ menu_short | default: "NYC School Lunch" }}</span>
  <span class="instance">NYC PS</span>
</div>
