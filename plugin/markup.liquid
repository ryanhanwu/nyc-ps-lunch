<div class="layout layout--col gap--space-between">

  <!-- Header: Title & Dietary Legend -->
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--center-y gap--small">
      <span class="title title--small lg:title--medium">🍎 What's for Lunch?</span>
      <span class="label label--small lg:label--base label--gray">{{ menu_short | default: "Pre-K – 8" }}</span>
    </div>
    <span class="label label--small lg:label--base label--gray">
      (V) Veggie &bull; (VE) Vegan &bull; (H) Halal
    </span>
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <div class="flex flex--col flex--center-y gap--small" style="padding: 40px 0;">
    <span class="title title--small">No School Lunch Menu Today</span>
    <span class="label label--gray">Check back on the next scheduled school day.</span>
  </div>
  {% else %}

  <!-- Today's Lunch Section -->
  <div class="flex flex--col gap--small">
    <div class="flex flex--between flex--center-y">
      <div class="flex flex--center-y gap--small">
        <span class="label label--filled lg:label--large">{{ current_day.status_label | default: "TODAY" }}</span>
        <span class="value value--medium lg:value--large"><strong>{{ current_day.day_name | default: current_day.day_short }}, {{ current_day.date }}</strong></span>
      </div>
      <div class="flex flex--center-y gap--small">
        {% if current_day.note %}
        <span class="label label--filled label--small lg:label--base">{{ current_day.note }}</span>
        {% endif %}
        {% if current_day.salad_bar %}
        <span class="label label--small lg:label--base label--underline">
          🥗 {{ current_day.salad_bar }}
        </span>
        {% endif %}
      </div>
    </div>

    <!-- Food Items: Left-aligned with comfortable reading size -->
    <div class="flex flex--col gap--tiny" style="text-align: left; padding-left: 2px;">
      {% for item in current_day.items %}
      <span class="value value--small lg:value--base" style="text-align: left; line-height: 1.3;">
        &bull; {{ item }}
      </span>
      {% endfor %}
    </div>
  </div>

  <div class="divider"></div>

  <!-- Tomorrow's Lunch Section -->
  {% if tomorrow or next_day_1 %}
  {% assign next_up = tomorrow | default: next_day_1 %}
  <div class="flex flex--col gap--tiny" style="text-align: left;">
    <div class="flex flex--between flex--center-y">
      <span class="label label--underline lg:label--base">
        {{ next_up.label | default: "TOMORROW'S LUNCH" }} &bull; {{ next_up.full_date }}
      </span>
      {% if next_up.salad_bar %}
      <span class="label label--small label--gray">
        Salad Bar: {{ next_up.salad_bar }}
      </span>
      {% endif %}
    </div>
    <span class="value value--small lg:value--base" style="text-align: left; line-height: 1.25;">
      {{ next_up.summary }}
    </span>
  </div>
  {% endif %}

  {% endif %}

  <!-- Footer -->
  <div class="flex flex--between flex--center-y">
    <span class="label label--small label--gray">NYC Department of Education &bull; {{ school_year | default: "2026-2027" }}</span>
    <span class="label label--small label--gray">Updated {{ updated_at | default: "Today" }}</span>
  </div>

</div>

<div class="title_bar">
  <span class="title">{{ menu_name | default: "NYC School Lunch" }}</span>
  <span class="instance">NYC PS</span>
</div>
