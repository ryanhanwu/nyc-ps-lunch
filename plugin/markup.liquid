<div class="layout layout--col layout--top layout--stretch-x gap--small lg:gap--medium portrait:gap--small">

  <!-- Header: Title & Dietary Legend -->
  <div class="flex flex--between flex--center-y portrait:flex--col portrait:flex--left portrait:gap--small">
    <span class="title title--small lg:title--large">What's for Lunch?</span>
    <span class="label label--small lg:label--large label--gray 1bit:text--black">
      (V) Veggie &bull; (VE) Vegan{% if show_halal %} &bull; (H) Halal{% endif %}
    </span>
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small grow">
    <span class="title title--small lg:title--base">No School Lunch Menu Today</span>
    <span class="label label--small lg:label--large label--gray 1bit:text--black">Check back on the next scheduled school day.</span>
  </div>
  {% else %}

  <!-- Today's Lunch Header -->
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--center-y gap--small">
      <span class="label label--inverted lg:label--large">{{ current_day.status_label | default: "TODAY" }}</span>
      <span class="value value--base lg:value--xlarge portrait:value--base" data-fit-value="true"><strong>{{ current_day.day_name | default: current_day.day_short }}, {{ current_day.date }}</strong></span>
    </div>
    <div class="flex flex--center-y gap--small">
      {% if current_day.note %}
      <span class="label label--inverted label--small lg:label--base">{{ current_day.note }}</span>
      {% endif %}
      {% if current_day.salad_bar %}
      <span class="label label--small lg:label--large label--underline" data-clamp="1">
        Salad Bar: {{ current_day.salad_bar }}
      </span>
      {% endif %}
    </div>
  </div>

  <!-- Today's Food Items: overflow keeps a 5th entree visible as "and N more" -->
  <div class="flex flex--col gap--small grow">
    <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
      <div class="column gap--small">
        {% for item in current_day.items %}
        <div class="item">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--base lg:value--xlarge portrait:value--small lg:portrait:value--base" data-clamp="1">&bull; {{ item }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Tomorrow's Lunch Section -->
  {% if next_up %}
  <div class="flex flex--between flex--center-y">
    <span class="label label--underline lg:label--large">
      {{ next_up.label | default: "TOMORROW'S LUNCH" }} &bull; {{ next_up.full_date }}
    </span>
    {% if next_up.salad_bar %}
    <span class="label label--small lg:label--large label--gray 1bit:text--black" data-clamp="1">
      Salad Bar: {{ next_up.salad_bar }}
    </span>
    {% endif %}
  </div>

  {% if next_up.items and next_up.items.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="2" data-overflow-max-cols-portrait="1" data-overflow-counter="true">
    <div class="column gap--small">
      {% for item in next_up.items %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small portrait:value--small lg:portrait:value--base" data-clamp="1">&bull; {{ item }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <span class="value value--small portrait:value--small lg:portrait:value--base" data-clamp="2">
    {{ next_up.summary }}
  </span>
  {% endif %}
  {% endif %}

  {% endif %}

  <!-- Footer -->
  <div class="flex flex--between flex--center-y">
    <span class="label label--small lg:label--large label--gray 1bit:text--black">NYC Department of Education{% if school_year %} &bull; {{ school_year }}{% endif %}</span>
    {% if updated_at %}
    <span class="label label--small lg:label--large label--gray 1bit:text--black">Updated {{ updated_at }}</span>
    {% endif %}
  </div>

</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_name, trmnl: trmnl %}
