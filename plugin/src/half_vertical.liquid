<div class="layout layout--col layout--top layout--stretch-x gap--small lg:gap--medium portrait:gap--small">
  <div class="flex flex--col flex--left gap--small">
    <span class="title title--small lg:title--base">{{ selected_short }} Lunch</span>
    <span class="label label--small lg:label--base label--gray 1bit:text--black">NYC Public Schools</span>
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <span class="label label--gray 1bit:text--black lg:label--base">No school lunch menu available.</span>
  {% else %}
  <span class="label label--underline lg:label--base">{{ current_day.status_label | default: "TODAY" }} &bull; {{ current_day.full_date }}</span>
  {% if current_day.items and current_day.items.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column gap--small">
      {% for item in current_day.items %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small lg:value--base" data-clamp="1">&bull; {{ item }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <span class="value value--small lg:value--base" data-clamp="3">{{ current_day.summary }}</span>
  {% endif %}
  {% if current_day.salad_bar %}
  <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="1">Salad Bar: {{ current_day.salad_bar }}</span>
  {% endif %}

  <div class="divider"></div>

  {% if next_up %}
  <span class="label label--underline lg:label--base">{{ next_up.label | default: "TOMORROW" }} ({{ next_up.full_date }})</span>
  {% if next_up.items and next_up.items.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column gap--small">
      {% for item in next_up.items %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--small lg:value--base" data-clamp="1">&bull; {{ item }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <span class="value value--small lg:value--base" data-clamp="2">{{ next_up.summary }}</span>
  {% endif %}
  {% endif %}
  {% endif %}
</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_short %}
