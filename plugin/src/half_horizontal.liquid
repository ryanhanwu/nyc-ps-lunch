<div class="layout layout--col layout--stretch-x gap--space-between lg:gap--large portrait:gap--tiny">
  <div class="flex flex--between flex--center-y">
    <span class="title title--small lg:title--large">{{ selected_short }} Lunch</span>
    {% if current_day %}
    <span class="label label--inverted lg:label--base">{{ current_day.full_date }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <span class="label label--gray 1bit:text--black lg:label--base">No school lunch menu available.</span>
  {% else %}
  <div class="columns gap--large">
    <!-- Today -->
    <div class="column">
      <div class="flex flex--col flex--left gap--tiny">
        <span class="label label--underline lg:label--base">{{ current_day.status_label | default: "TODAY" }}</span>
        {% if current_day.items and current_day.items.size > 0 %}
        <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
          <div class="column">
            {% for item in current_day.items limit: 3 %}
            <span class="value value--small lg:value--base text--left" data-clamp="1">&bull; {{ item }}</span>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <span class="value value--small lg:value--base text--left" data-clamp="2">{{ current_day.summary }}</span>
        {% endif %}
      </div>
    </div>

    <!-- Tomorrow -->
    {% if next_up %}
    <div class="column">
      <div class="flex flex--col flex--left gap--tiny">
        <span class="label label--underline lg:label--base">{{ next_up.label | default: "TOMORROW" }} ({{ next_up.day_short | default: next_up.full_date }})</span>
        {% if next_up.items and next_up.items.size > 0 %}
        <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
          <div class="column">
            {% for item in next_up.items limit: 3 %}
            <span class="value value--small lg:value--base text--left" data-clamp="1">&bull; {{ item }}</span>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <span class="value value--small lg:value--base text--left" data-clamp="2">{{ next_up.summary }}</span>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_short %}
