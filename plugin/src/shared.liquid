{%- assign selected_name = menu_name | default: "Pre-K - 8 Lunch Menu" -%}
{%- assign selected_short = menu_short | default: "Pre-K – 8" -%}
{%- assign next_up = tomorrow | default: next_day_1 -%}

{%- assign show_halal = is_halal | default: false -%}
{%- if selected_name contains "Halal" or selected_short contains "Halal" -%}
  {%- assign show_halal = true -%}
{%- endif -%}

{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/>
  <path d="M10 2c1 .5 2 2 2 5"/>
</svg>
{%- endcapture -%}

{% template title_bar %}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">NYC PS</span>
</div>
{% endtemplate %}
