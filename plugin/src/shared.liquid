{%- assign raw_menu = trmnl.plugin_settings.custom_fields_values.menu_type | default: menu_type | downcase | strip | replace: "_", " " -%}

{%- capture menu_lookup -%}
pre-k - 8 lunch menu||Pre-K - 8 Lunch Menu||Pre-K – 8;;pre-k - 8 lunch menu with halal option||Pre-K - 8 Lunch Menu (Halal)||Pre-K – 8 (Halal);;pre-k - 8 vegetarian lunch menu||Pre-K - 8 Vegetarian Lunch Menu||Pre-K – 8 Vegetarian;;pre-k - 8 express hot lunch menu||Pre-K - 8 Express Hot Lunch Menu||Pre-K – 8 Express Hot;;pre-k - 8 express hot lunch menu with halal option||Pre-K - 8 Express Hot (Halal)||Pre-K – 8 Express Hot (Halal);;pre-k - 8 express cold lunch menu||Pre-K - 8 Express Cold Lunch Menu||Pre-K – 8 Express Cold;;pre-k - 8 express cold lunch menu with halal option||Pre-K - 8 Express Cold (Halal)||Pre-K – 8 Express Cold (Halal);;high school lunch menu||High School Lunch Menu||High School;;high school lunch menu with halal option||High School Lunch Menu (Halal)||High School (Halal);;high school express hot lunch menu||High School Express Hot Lunch Menu||HS Express Hot;;high school express hot lunch menu with halal option||High School Express Hot (Halal)||HS Express Hot (Halal);;high school express cold lunch menu||High School Express Cold Lunch Menu||HS Express Cold;;food court menu||Food Court Menu||Food Court;;food court menu with halal option||Food Court Menu (Halal)||Food Court (Halal);;infant toddler lunch menu||Infant Toddler Lunch Menu||Infant & Toddler
{%- endcapture -%}

{%- assign fallback_name = "" -%}
{%- assign fallback_short = "" -%}
{%- assign menu_rows = menu_lookup | strip | split: ";;" -%}
{%- for row in menu_rows -%}
  {%- assign cols = row | split: "||" -%}
  {%- if cols[0] == raw_menu -%}
    {%- assign fallback_name = cols[1] -%}
    {%- assign fallback_short = cols[2] -%}
  {%- endif -%}
{%- endfor -%}
{%- if fallback_name == "" -%}
  {%- assign fallback_name = "Pre-K - 8 Lunch Menu" -%}
  {%- assign fallback_short = "Pre-K – 8" -%}
{%- endif -%}

{%- assign selected_name = menu_name | default: fallback_name -%}
{%- assign selected_short = menu_short | default: fallback_short -%}

{%- assign next_up = tomorrow | default: next_day_1 -%}
{%- assign today_items = current_day.items -%}
{%- assign today_summary = current_day.summary -%}

{%- capture svg_logo -%}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/>
  <path d="M10 2c1 .5 2 2 2 5"/>
</svg>
{%- endcapture -%}

{% template title_bar %}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ svg_logo | base64_encode }}" />
  <span class="title">{{ title }}</span>
  <span class="instance">NYC PS</span>
</div>
{% endtemplate %}
