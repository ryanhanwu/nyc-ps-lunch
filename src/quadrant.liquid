<div class="layout layout--col layout--top layout--stretch-x gap--small lg:gap--medium portrait:gap--tiny">
  <div class="flex flex--col flex--left gap--tiny">
    <span class="title title--small lg:title--base">{{ selected_short }} Lunch</span>
    {% if current_day %}
    <span class="label label--small lg:label--base">{{ current_day.full_date }} &bull; {{ current_day.status_label | default: "TODAY" }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <span class="label label--gray 1bit:text--black lg:label--base">No menu available</span>
  {% else %}
  {% if current_day.items and current_day.items.size > 0 %}
  <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
    <div class="column gap--tiny">
      {% for item in current_day.items %}
      <div class="item">
        <span class="value value--small lg:value--base" data-clamp="1">&bull; {{ item }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <span class="value value--small lg:value--base" data-clamp="2">{{ current_day.summary }}</span>
  {% endif %}
  {% if next_up %}
  <span class="label label--gray 1bit:text--black label--small lg:label--base" data-clamp="2" data-clamp-portrait="1">Tomorrow: {{ next_up.summary }}</span>
  {% endif %}
  {% endif %}
</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_short %}
