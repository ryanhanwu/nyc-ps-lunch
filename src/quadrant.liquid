<div class="layout layout--col gap--space-between lg:gap--medium portrait:gap--tiny">
  <div class="flex flex--col gap--tiny">
    <span class="title title--small lg:title--medium">🍎 {{ menu_short | default: "Pre-K – 8" }} Lunch</span>
    {% if current_day %}
    <span class="label label--small">{{ current_day.full_date }} &bull; {{ current_day.status_label | default: "TODAY" }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if current_day %}
  <div class="flex flex--col gap--tiny" style="text-align: left;">
    {% for item in current_day.items limit: 3 %}
    <span class="value value--small" style="text-align: left; line-height: 1.2;">&bull; {{ item }}</span>
    {% endfor %}
  </div>
  {% if tomorrow or next_day_1 %}
  {% assign next_up = tomorrow | default: next_day_1 %}
  <span class="label label--gray label--small">Tomorrow: {{ next_up.items | first }}</span>
  {% endif %}
  {% else %}
  <span class="label label--gray lg:label--base">No menu available</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ menu_short | default: "NYC School Lunch" }}</span>
  <span class="instance">NYC PS</span>
</div>
