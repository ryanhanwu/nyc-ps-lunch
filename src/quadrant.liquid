<div class="layout layout--col gap--space-between lg:gap--medium portrait:gap--tiny">
  <div class="flex flex--col gap--tiny">
    <span class="title title--small lg:title--large">
      {{ menu_short | default: "Pre-K – 8" }}
       Lunch
    </span>
    {% if current_day %}
      <span class="label label--small lg:label--large">
        {{ current_day.full_date }}
         • 
        {{ current_day.status_label | default: "TODAY" }}
      </span>
    {% endif %}
  </div>
  <div class="divider"></div>
  {% if current_day %}
    <div class="flex flex--col gap--tiny">
      {% for item in current_day.items limit: 3 %}
        <span class="value value--small lg:value--base">
          • 
          {{ item }}
        </span>
      {% endfor %}
    </div>
    {% else %}
    <span class="label label--gray lg:label--base">No menu available</span>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">
    {{ menu_short | default: "NYC School Lunch" }}
  </span>
  <span class="instance">NYC PS</span>
</div>