<div class="layout layout--col layout--stretch-x gap--space-between lg:gap--large portrait:gap--small">
  <div class="flex flex--col flex--left gap--tiny">
    <span class="title title--small lg:title--base">{{ selected_short }} Lunch</span>
    <span class="label label--small lg:label--base label--gray 1bit:text--black">NYC Public Schools</span>
  </div>

  <div class="divider"></div>

  {% if current_day %}
  <div class="flex flex--col flex--left gap--tiny">
    <span class="label label--underline lg:label--base">{{ current_day.status_label | default: "TODAY" }} &bull; {{ current_day.full_date }}</span>
    {% for item in current_day.items limit: 4 %}
    <span class="value value--small lg:value--base text--left" data-clamp="1">&bull; {{ item }}</span>
    {% endfor %}
    {% if current_day.salad_bar %}
    <span class="label label--small lg:label--base label--gray 1bit:text--black text--left" data-clamp="1">Salad Bar: {{ current_day.salad_bar }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if tomorrow or next_day_1 %}
  {% assign next_up = tomorrow | default: next_day_1 %}
  <div class="flex flex--col flex--left gap--tiny">
    <span class="label label--underline lg:label--base">{{ next_up.label | default: "TOMORROW" }} ({{ next_up.full_date }})</span>
    <span class="value value--small lg:value--base text--left" data-clamp="2" data-clamp-lg="3">
      {{ next_up.summary }}
    </span>
  </div>
  {% endif %}
  {% else %}
  <span class="label label--gray 1bit:text--black lg:label--base">No school lunch menu available.</span>
  {% endif %}
</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_short %}
