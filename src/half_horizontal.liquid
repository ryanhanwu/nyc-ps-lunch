{% assign selected_short = menu_short | default: trmnl.plugin_settings.custom_fields_values.menu_type | default: menu_type | default: "Pre-K – 8" %}

<div class="layout layout--col layout--stretch-x gap--space-between lg:gap--large portrait:gap--tiny">
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--center-y gap--small">
      <svg class="image image--stroke" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/>
        <path d="M10 2c1 .5 2 2 2 5"/>
      </svg>
      <span class="title title--small lg:title--large">{{ selected_short }} Lunch</span>
    </div>
    {% if current_day %}
    <span class="label label--inverted lg:label--base">{{ current_day.full_date }}</span>
    {% endif %}
  </div>

  <div class="divider"></div>

  {% if current_day %}
  <div class="columns gap--large">
    <!-- Today -->
    <div class="column">
      <div class="flex flex--col flex--left gap--tiny">
        <span class="label label--underline lg:label--base">{{ current_day.status_label | default: "TODAY" }}</span>
        {% for item in current_day.items limit: 3 %}
        <span class="value value--small lg:value--base text--left" data-clamp="1">&bull; {{ item }}</span>
        {% endfor %}
      </div>
    </div>

    <!-- Tomorrow -->
    {% if tomorrow or next_day_1 %}
    {% assign next_up = tomorrow | default: next_day_1 %}
    <div class="column">
      <div class="flex flex--col flex--left gap--tiny">
        <span class="label label--underline lg:label--base">{{ next_up.label | default: "TOMORROW" }} ({{ next_up.day_short }})</span>
        {% for item in next_up.items limit: 3 %}
        <span class="value value--small lg:value--base text--left" data-clamp="1">&bull; {{ item }}</span>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  {% else %}
  <span class="label label--gray lg:label--base">No school lunch menu available.</span>
  {% endif %}
</div>

<div class="title_bar">
  <svg class="image image--stroke" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 20.94c1.5 0 2.75 1.06 4 1.06 3 0 6-8 6-12.22A4.91 4.91 0 0 0 17 5c-2.22 0-4 1.44-5 2-1-.56-2.78-2-5-2a4.9 4.9 0 0 0-5 4.78C2 14 5 22 8 22c1.25 0 2.5-1.06 4-1.06Z"/>
    <path d="M10 2c1 .5 2 2 2 5"/>
  </svg>
  <span class="title">{{ selected_short }}</span>
  <span class="instance">NYC PS</span>
</div>
