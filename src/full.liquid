<div class="layout layout--col layout--stretch-x gap--space-between">

  <!-- Header: Title & Dietary Legend -->
  <div class="flex flex--between flex--center-y">
    <div class="flex flex--center-y gap--small">
      <span class="title title--small lg:title--large">What's for Lunch?</span>
      <span class="label label--small lg:label--base label--outline">{{ selected_short }}</span>
    </div>
    <span class="label label--small lg:label--base label--gray 1bit:text--black">
      (V) Veggie &bull; (VE) Vegan &bull; (H) Halal
    </span>
  </div>

  <div class="divider"></div>

  {% if no_menu or current_day == nil %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small">
    <span class="title title--small lg:title--base">No School Lunch Menu Today</span>
    <span class="label label--small lg:label--base label--gray 1bit:text--black">Check back on the next scheduled school day.</span>
  </div>
  {% else %}

  <!-- Today's Lunch Section -->
  <div class="flex flex--col flex--stretch-x gap--small lg:gap--medium">
    <div class="flex flex--between flex--center-y">
      <div class="flex flex--center-y gap--small">
        <span class="label label--inverted lg:label--large">{{ current_day.status_label | default: "TODAY" }}</span>
        <span class="value value--base lg:value--large" data-fit-value="true"><strong>{{ current_day.day_name | default: current_day.day_short }}, {{ current_day.date }}</strong></span>
      </div>
      <div class="flex flex--center-y gap--small">
        {% if current_day.note %}
        <span class="label label--inverted label--small lg:label--base">{{ current_day.note }}</span>
        {% endif %}
        {% if current_day.salad_bar %}
        <span class="label label--small lg:label--base label--underline" data-clamp="1">
          Salad Bar: {{ current_day.salad_bar }}
        </span>
        {% endif %}
      </div>
    </div>

    <!-- Food Items: overflow engine caps the list so a long menu can't push the footer off -->
    <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
      <div class="column">
        {% for item in current_day.items limit: 5 %}
        <span class="value value--small lg:value--xlarge text--left" data-clamp="1">&bull; {{ item }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Tomorrow's Lunch Section -->
  {% if next_up %}
  {% assign has_next_items = false %}
  {% if next_up.items and next_up.items.size > 0 %}{% assign has_next_items = true %}{% endif %}
  <div class="flex flex--col flex--stretch-x gap--tiny lg:gap--small">
    <div class="flex flex--between flex--center-y">
      <span class="label label--underline lg:label--large">
        {{ next_up.label | default: "TOMORROW'S LUNCH" }} &bull; {{ next_up.full_date }}
      </span>
      {% if next_up.salad_bar %}
      <span class="label label--small lg:label--base label--gray 1bit:text--black" data-clamp="1">
        Salad Bar: {{ next_up.salad_bar }}
      </span>
      {% endif %}
    </div>

    <!-- OG: one-line summary. X: the full menu, and the summary only when the feed has no item list -->
    <span class="value value--small lg:value--large text--left{% if has_next_items %} lg:hidden{% endif %}" data-clamp="2">
      {{ next_up.summary }}
    </span>
    {% if has_next_items %}
    <div class="hidden lg:flex flex--col gap--tiny">
      {% for item in next_up.items limit: 4 %}
      <span class="value value--small lg:value--large text--left" data-clamp="1">&bull; {{ item }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endif %}

  {% endif %}

  <!-- Footer -->
  <div class="flex flex--between flex--center-y">
    <span class="label label--small lg:label--large label--gray 1bit:text--black">NYC Department of Education &bull; {{ school_year | default: "2026-2027" }}</span>
    <span class="label label--small lg:label--large label--gray 1bit:text--black">Updated {{ updated_at | default: "Today" }}</span>
  </div>

</div>

{% render 'title_bar', svg_logo: svg_logo, title: selected_name %}
